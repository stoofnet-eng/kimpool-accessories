  background:
    radial-gradient(circle at 20% 50%,rgba(0,216,120,.18),transparent 30%),
    linear-gradient(120deg,#071614,#030708);
  padding:70px 0;text-align:center
}
.final-cta h2{font-size:32px;margin-bottom:8px}
.final-cta p{color:#aeb9b9;margin-bottom:22px}

/* FOOTER */
footer{background:#030708;border-top:1px solid var(--line);padding:30px 0;color:#778282}
.footer-inner{display:flex;align-items:center;justify-content:space-between;gap:20px}
.footer-logo{color:white;font-weight:900;font-size:22px}
.social{display:flex;gap:15px;font-size:18px}

/* MOBILE */
@media(max-width:900px){
  .menu{display:none}
  .categories{grid-template-columns:repeat(3,1fr)}
  .products{grid-template-columns:repeat(2,1fr)}
  .benefits{grid-template-columns:repeat(2,1fr)}
  .benefit:nth-child(2){border-left:0}
  .offer-inner{grid-template-columns:1fr}
  .offer-visual{min-height:220px}
