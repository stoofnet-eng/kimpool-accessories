<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="KIMPOOL Accessories - إكسسوارات البلياردو">
<title>KIMPOOL | Accessories</title>

<style>
:root{
  --bg:#05090a;
  --bg2:#091112;
  --card:#0b1416;
  --line:#203033;
  --green:#00d878;
  --green2:#08a95f;
  --gold:#e7b83f;
  --white:#f7f8f7;
  --muted:#aab5b5;
  --shadow:0 18px 50px rgba(0,0,0,.35);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:Tahoma,Arial,sans-serif;
  background:var(--bg);
  color:var(--white);
  line-height:1.7;
}
a{text-decoration:none;color:inherit}
button{font:inherit}
.container{width:min(1180px,92%);margin:auto}

/* NAV */
.nav{
  position:sticky;top:0;z-index:1000;
  background:rgba(4,8,9,.94);
  backdrop-filter:blur(14px);
  border-bottom:1px solid rgba(255,255,255,.06);
}
.nav-inner{
  height:72px;display:flex;align-items:center;justify-content:space-between;gap:20px
}
.logo{display:flex;align-items:center;gap:10px;font-weight:900;letter-spacing:1px}
.logo-mark{
  width:38px;height:38px;border:2px solid var(--gold);border-radius:50%;
  display:grid;place-items:center;color:var(--gold);font-size:18px
}
.logo small{display:block;color:var(--gold);font-size:8px;letter-spacing:2px}
.menu{display:flex;gap:30px;color:#ddd;font-size:14px}
.menu a:hover{color:var(--gold)}
.nav-actions{display:flex;align-items:center;gap:14px}
.icon{font-size:20px;color:#ddd}
.wa-mini{color:var(--green);font-size:24px}

/* HERO */
.hero{
  min-height:570px;
  position:relative;overflow:hidden;
  background:
    radial-gradient(circle at 15% 60%,rgba(0,216,120,.16),transparent 30%),
    linear-gradient(90deg,rgba(2,7,8,.15),rgba(2,7,8,.92)),
    url("https://images.unsplash.com/photo-1612534847738-8c2c5f1d2e3a?auto=format&fit=crop&w=1800&q=85") center/cover;
}
.hero:after{
  content:"";position:absolute;inset:0;
  background:linear-gradient(90deg,rgba(3,7,8,.2),rgba(3,7,8,.8));
}
.hero-content{
  position:relative;z-index:1;min-height:570px;
  display:flex;align-items:center;justify-content:flex-end
}
.hero-copy{width:min(560px,100%);text-align:right}
.eyebrow{color:var(--gold);font-size:14px;font-weight:bold;margin-bottom:10px}
.hero h1{font-size:clamp(38px,5vw,64px);line-height:1.08;margin-bottom:20px}
.hero h1 span{color:var(--gold)}
.hero p{font-size:18px;color:#ddd;max-width:520px;margin-bottom:30px}
.buttons{display:flex;gap:12px;flex-wrap:wrap}
.btn{
  border:1px solid rgba(255,255,255,.7);border-radius:999px;
  padding:13px 26px;display:inline-flex;align-items:center;gap:9px;
  cursor:pointer;transition:.25s
}
.btn:hover{transform:translateY(-2px)}
.btn-green{background:var(--green);color:#00150b;border-color:var(--green);font-weight:800}
.btn-outline{background:rgba(0,0,0,.15);color:#fff}
.btn-gold{background:var(--gold);color:#151000;border-color:var(--gold);font-weight:800}

/* CATEGORIES */
.section{padding:58px 0}
.section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:25px}
.section-title{font-size:30px}
.section-link{color:var(--green);font-size:14px}
.categories{display:grid;grid-template-columns:repeat(6,1fr);gap:12px}
.category{
  min-height:130px;border:1px solid var(--line);background:linear-gradient(180deg,#0c1618,#081012);
  border-radius:14px;padding:15px;display:flex;flex-direction:column;align-items:center;justify-content:center;
  text-align:center;transition:.25s
}
.category:hover{border-color:#3a6c5a;transform:translateY(-4px)}
.cat-icon{font-size:42px;margin-bottom:9px;filter:drop-shadow(0 5px 8px rgba(0,0,0,.5))}
.category b{font-size:13px}

/* PRODUCTS */
.products{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.product{
  position:relative;overflow:hidden;background:#0b1315;border:1px solid #203034;
  border-radius:12px;box-shadow:var(--shadow)
}
.product-img{
  height:235px;display:grid;place-items:center;position:relative;overflow:hidden;
  background:
    radial-gradient(circle at 50% 45%,rgba(0,216,120,.14),transparent 40%),
    linear-gradient(135deg,#172426,#070c0d)
}
.product-img img{width:100%;height:100%;object-fit:cover;opacity:.94}
.product-body{padding:17px}
.badge{
  position:absolute;top:12px;right:12px;background:var(--gold);color:#171000;
  padding:5px 10px;border-radius:7px;font-size:11px;font-weight:900
}
.product h3{font-size:17px;margin-bottom:4px}
.product p{color:#99a5a5;font-size:12px;margin-bottom:12px}
.price{font-size:20px;font-weight:900;margin-bottom:12px}
.order{
  width:100%;border:0;border-radius:999px;padding:11px;background:var(--green);
  color:#00170c;font-weight:900;cursor:pointer
}

/* OFFER */
.offer{
  position:relative;overflow:hidden;background:
  radial-gradient(circle at 20% 50%,rgba(0,216,120,.22),transparent 35%),
  linear-gradient(90deg,#0a2018,#06100f);
  border-top:1px solid #1d4235;border-bottom:1px solid #1d4235;
}
.offer-inner{min-height:340px;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:30px}
.offer-visual{
  min-height:290px;border-radius:18px;
  background:
    radial-gradient(circle at 40% 45%,rgba(0,216,120,.25),transparent 28%),
    linear-gradient(145deg,#10241e,#070c0d);
  display:grid;place-items:center;font-size:105px;
  box-shadow:inset 0 0 80px rgba(0,0,0,.4)
}
.offer-copy h2{font-size:36px;color:var(--gold);margin-bottom:5px}
.offer-copy h3{font-size:18px;margin-bottom:12px}
.checks{list-style:none;color:#ddd;margin:18px 0}
.checks li{margin:7px 0}
.checks li:before{content:"✓";color:var(--green);font-weight:900;margin-left:9px}
.old{color:#788383;text-decoration:line-through;margin-left:10px}
.offer-price{font-size:27px;color:var(--gold);font-weight:900;margin-bottom:15px}

/* BENEFITS */
.benefits{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.benefit{padding:35px 20px;text-align:center;border-left:1px solid var(--line)}
.benefit:last-child{border-left:0}
.benefit-icon{font-size:34px;color:var(--gold);margin-bottom:8px}
.benefit h3{font-size:16px;margin-bottom:4px}
.benefit p{font-size:12px;color:#9ba6a6}

/* TESTIMONIALS */
.light-section{background:#f5f5f2;color:#111;padding:55px 0}
.light-section .section-title{color:#111}
.testimonials{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.review{background:white;border-radius:12px;padding:22px;box-shadow:0 10px 30px rgba(0,0,0,.08)}
.person{display:flex;align-items:center;gap:12px;margin-bottom:12px}
.avatar{width:43px;height:43px;border-radius:50%;background:linear-gradient(135deg,#263334,#8f9b9a);display:grid;place-items:center;color:white;font-weight:bold}
.stars{color:#e8b52f;font-size:13px}
.review p{font-size:13px;color:#555}

/* FAQ */
.faq{display:grid;gap:10px;max-width:850px;margin:auto}
details{border:1px solid var(--line);background:#091113;border-radius:10px;padding:16px 20px}
summary{cursor:pointer;font-weight:bold;list-style:none}
summary::-webkit-details-marker{display:none}
summary:after{content:"+";float:left;color:var(--gold);font-size:20px}
details[open] summary:after{content:"−"}
details p{color:#9da7a7;padding-top:10px;font-size:13px}

/* CTA */
.final-cta{
