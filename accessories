<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<title>KIMPOOL — العرض التجاري للمقاهي والأوتيلات</title>
<style>
:root{--bg:#05090a;--card:#0b1416;--line:#203033;--green:#00d878;--gold:#e7b83f;--white:#f7f8f7;--muted:#aab5b5}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Tahoma,Arial,sans-serif;background:var(--bg);color:var(--white);line-height:1.8}
.page{width:min(820px,94%);margin:auto;padding:40px 0}
.header{text-align:center;padding:30px 0;border-bottom:2px solid var(--gold);margin-bottom:30px}
.logo{font-size:34px;font-weight:900;letter-spacing:2px}
.logo span{color:var(--gold)}
.tagline{color:var(--muted);margin-top:6px;font-size:14px}
h1{font-size:26px;color:var(--gold);text-align:center;margin-bottom:8px}
.sub{text-align:center;color:var(--muted);margin-bottom:28px;font-size:15px}
.intro{background:linear-gradient(135deg,#0c1a16,#081012);border:1px solid #1d4235;border-radius:14px;padding:22px;margin-bottom:28px;font-size:14.5px;color:#d8e0e0}
.intro b{color:var(--green)}
.tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:28px}
.tier{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:20px;display:flex;flex-direction:column}
.tier.featured{border-color:var(--gold);box-shadow:0 0 25px rgba(231,184,63,.15)}
.tier-icon{font-size:36px;margin-bottom:8px}
.tier h2{font-size:18px;color:var(--gold);margin-bottom:4px}
.tier .for{font-size:11px;color:var(--muted);margin-bottom:12px}
.tier ul{list-style:none;flex:1}
.tier li{font-size:12.5px;color:#cfd8d8;padding:5px 0;border-bottom:1px dashed #1a2a2c}
.tier li:before{content:"✓ ";color:var(--green);font-weight:900}
.note{font-size:11px;color:var(--muted);text-align:center;margin-top:10px}
.why{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:28px}
.why-item{background:#081012;border:1px solid var(--line);border-radius:12px;padding:16px 10px;text-align:center}
.why-item .ic{font-size:26px;margin-bottom:6px}
.why-item b{font-size:12.5px;display:block;margin-bottom:3px}
.why-item p{font-size:11px;color:var(--muted)}
.steps{margin-bottom:28px}
.step{display:flex;gap:14px;align-items:flex-start;margin-bottom:14px}
.num{background:var(--green);color:#00150b;font-weight:900;width:32px;height:32px;border-radius:50%;display:grid;place-items:center;flex-shrink:0;font-size:15px}
.step b{font-size:14.5px}
.step p{font-size:12.5px;color:var(--muted)}
.cta{background:linear-gradient(120deg,#0a2018,#06100f);border:1px solid #1d4235;border-radius:16px;padding:28px;text-align:center;margin-bottom:24px}
.cta h2{color:var(--gold);font-size:22px;margin-bottom:8px}
.cta p{color:#c9d4d4;font-size:14px;margin-bottom:16px}
.wa-btn{display:inline-block;background:var(--green);color:#00170c;font-weight:900;padding:13px 34px;border-radius:999px;font-size:15px;text-decoration:none}
.footer{text-align:center;color:#5a6a6a;font-size:11px;padding-top:16px;border-top:1px solid var(--line)}
@media(max-width:700px){.tiers{grid-template-columns:1fr}.why{grid-template-columns:repeat(2,1fr)}}
</style>
<base target="_blank">
</head>
<body>
<div class="page">

<div class="header">
  <div class="logo">♛ <span>KIMPOOL</span></div>
  <div class="tagline">BILLIARDS ACCESSORIES • MAINTENANCE • FULL EQUIPMENT</div>
</div>

